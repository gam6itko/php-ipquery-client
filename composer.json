{
    "name": "gam6itko/ipquery-client",
    "description": "Framework-agnostic PHP client for a self-hosted IPQuery geo service (akyriako/ipquery)",
    "keywords": ["ipquery", "geoip", "geolocation", "ip", "country", "psr-18", "psr-17"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexander Strizhak",
            "email": "gam6itko@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "psr/http-client": "^1.0.3",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "infection/infection": "^0.35 || ^0.27",
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "^13.0 || ^12.0 || ^11.0 || ^10.0",
        "vimeo/psalm": "^6.0"
    },
    "suggest": {
        "nyholm/psr7": "PSR-7/17 implementation (request, URI and response factories)",
        "symfony/http-client": "PSR-18 HTTP client",
        "guzzlehttp/guzzle": "PSR-18 HTTP client with PSR-7/17 implementation",
        "psr/simple-cache-implementation": "PSR-16 cache for CachedIPQuery"
    },
    "autoload": {
        "psr-4": {
            "Gam6itko\\IPQuery\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gam6itko\\IPQuery\\Tests\\": "tests"
        }
    },
    "scripts": {
        "csfix": "php-cs-fixer fix",
        "infection": "infection --threads=max",
        "psalm": "psalm --no-cache",
        "tests": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "php-http/discovery": false
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    }
}
